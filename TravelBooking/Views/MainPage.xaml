<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="TravelBooking.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:res="clr-namespace:TravelBooking.Resources.Strings">

    <ContentPage.Resources>
        <Color x:Key="TravelBlue">#2991F3</Color>
        <Color x:Key="TravelGold">#FFD700</Color>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="30,0" Spacing="25">
            <Image
                Aspect="AspectFit"
                HeightRequest="185"
                SemanticProperties.Description="dot net bot in a submarine number ten"
                Source="dotnet_bot.png" />

            <Label
                SemanticProperties.HeadingLevel="Level1"
                Style="{StaticResource Headline}"
                Text="{x:Static res:AppResources.WelcomeMessage}" />

            <Label
                SemanticProperties.Description="Welcome to dot net Multi platform App U I"
                SemanticProperties.HeadingLevel="Level2"
                Style="{StaticResource SubHeadline}"
                Text="Welcome to &#10;.NET Multi-platform App UI" />

            <HorizontalStackLayout>
                <Button
                    x:Name="btncancel"
                    Clicked="btncancel_Clicked"
                    HorizontalOptions="Fill"
                    Text="Cancel" />

                <Button
                    x:Name="btnAction"
                    Clicked="btnAction_Clicked"
                    HorizontalOptions="Fill"
                    Text="Action Sheet" />

                <Button
                    x:Name="btnpassenger"
                    Clicked="btnpassenger_Clicked"
                    HorizontalOptions="Fill"
                    Text="Click me" />

                <Button
                    x:Name="btnDestination"
                    Clicked="btnDestination_Clicked"
                    HorizontalOptions="Fill"
                    Text="Click me" />

                <Button
                    x:Name="btnbookflight"
                    BackgroundColor="{StaticResource TravelGold}"
                    Clicked="btnflight_Clicked"
                    HorizontalOptions="Fill"
                    Text="{x:Static res:AppResources.Book_Flight}"
                    TextColor="Black" />

                <Button
                    x:Name="btnGoBook"
                    BackgroundColor="{StaticResource TravelGold}"
                    Clicked="btnGoBook_Clicked"
                    HorizontalOptions="Fill"
                    Text="Go to Booking"
                    TextColor="Black" />

            </HorizontalStackLayout>

            <Button
                x:Name="btnBookValue"
                BackgroundColor="Green"
                Clicked="btnBookValue_Clicked"
                HorizontalOptions="Fill"
                Text="Booking Page"
                TextColor="Black" />

            <Button
                x:Name="btnOpenModal"
                BackgroundColor="PaleGreen"
                Clicked="btnOpenModal_Clicked"
                HorizontalOptions="Fill"
                Text="Open Modal"
                TextColor="Black" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
